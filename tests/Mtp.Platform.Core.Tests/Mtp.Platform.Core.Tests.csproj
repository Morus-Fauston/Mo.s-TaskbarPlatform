<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mtp.Platform.Core\Mtp.Platform.Core.csproj" />
    <ProjectReference Include="..\..\src\Mtp.Contracts\Mtp.Contracts.csproj" />
    <ProjectReference Include="../../src/Mtp.Host.Runtime/Mtp.Host.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\Mtp.Host\MainWindow.xaml" Link="MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Mtp.PreferenceStore.ProcessProbe/Mtp.PreferenceStore.ProcessProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPreferenceProbe" AfterTargets="Build">
    <ItemGroup>
      <PreferenceProbeFiles Include="../Mtp.PreferenceStore.ProcessProbe/bin/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PreferenceProbeFiles)" DestinationFolder="$(OutDir)PreferenceProbe" />
  </Target>

</Project>
