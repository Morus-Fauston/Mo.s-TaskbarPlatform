  <Import Project="../../build/CommunicationRuntimes.targets" />
  <Target Name="CopyCommunicationProbe" AfterTargets="Build">
    <MSBuild Projects="../Mtp.Communication.ProcessProbe/Mtp.Communication.ProcessProbe.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0">
      <Output TaskParameter="TargetOutputs" ItemName="_CommunicationProbeAssembly" />
    </MSBuild>
    <ItemGroup>
      <_CommunicationProbeFiles Include="@(_CommunicationProbeAssembly);@(_CommunicationProbeAssembly->'%(RootDir)%(Directory)Mtp.Communication.ProcessProbe.deps.json');@(_CommunicationProbeAssembly->'%(RootDir)%(Directory)Mtp.Communication.ProcessProbe.runtimeconfig.json');@(_CommunicationProbeAssembly->'%(RootDir)%(Directory)Mtp.Contracts.dll');@(_CommunicationProbeAssembly->'%(RootDir)%(Directory)Mtp.Transport.dll');@(_CommunicationProbeAssembly->'%(RootDir)%(Directory)Mtp.Sdk.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_CommunicationProbeFiles)" DestinationFolder="$(OutDir)CommunicationProcessProbe" />
  </Target>
