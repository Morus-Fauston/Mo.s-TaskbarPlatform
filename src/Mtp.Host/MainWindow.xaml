<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mtp.Host.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MTP Host">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock
                Text="MTP Host"
                Style="{StaticResource TitleTextBlockStyle}" />

            <ToggleSwitch
                x:Name="VisibilityToggle"
                Header="显示组件"
                IsOn="False"
                IsEnabled="False"
                Toggled="VisibilityToggle_Toggled" />

            <ComboBox x:Name="TargetDisplayCombo" Header="目标显示器" HorizontalAlignment="Stretch"
                SelectionChanged="TargetDisplayCombo_SelectionChanged" />
            <NumberBox x:Name="RightGapInput" Header="右侧避让距离（DIP）" Minimum="0" Maximum="64"
                Value="8" SmallChange="1" LargeChange="8" SpinButtonPlacementMode="Inline"
                ValueChanged="RightGapInput_ValueChanged" />
            <TextBlock Text="位置：靠右" />
            <TextBlock x:Name="DockStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

            <Expander Header="实验探针" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <StackPanel Spacing="8">
                    <Button
                        x:Name="RunProbeButton"
                        Content="运行 Explorer 嵌入探针"
                        IsEnabled="False"
                        Click="RunProbeButton_Click" />
                    <Button
                        x:Name="StopProbeButton"
                        Content="停止探针，恢复独立贴靠"
                        IsEnabled="False"
                        Click="StopProbeButton_Click" />
                </StackPanel>
                <CheckBox
                    x:Name="SimulateFailureCheck"
                    Content="模拟任务栏不可用（失败注入）"
                    Checked="SimulateFailureCheck_Changed" Unchecked="SimulateFailureCheck_Changed" />
                <ComboBox
                    x:Name="MaterialCombo"
                    Header="顶级对照窗口材质"
                    SelectionChanged="MaterialCombo_SelectionChanged"
                    HorizontalAlignment="Stretch" />
                <Slider
                    x:Name="MaterialOpacitySlider"
                    Header="不透明度"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="0.05"
                    Value="0.8"
                    ValueChanged="MaterialOpacitySlider_ValueChanged"
                    HorizontalAlignment="Stretch" />
                <TextBlock
                    x:Name="MaterialStatusText"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
                <ComboBox
                    x:Name="TransparencyModeCombo"
                    Header="子窗口探针透明实验模式"
                    SelectedIndex="2"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Backdrop：透明 backdrop + DWM 玻璃扩展" />
                    <ComboBoxItem Content="TintDiagnostic：半透明红 backdrop + DWM 玻璃扩展（截图可见）" />
                    <ComboBoxItem Content="AcrylicController：薄亚克力控制器 + DWM 玻璃扩展（DeskBox 同路径）" />
                    <ComboBoxItem Content="NearTransparentBackdrop：alpha=1 近透明 backdrop + DWM 玻璃扩展" />
                    <ComboBoxItem Content="SolidPaint：纯色色刷 + DWM 玻璃扩展 + 一次 GDI 绘制（修复 alpha 丢失）" />
                </ComboBox>
                <Button
                    x:Name="TopLevelControlButton"
                    Content="显示透明顶级对照窗口"
                    Click="TopLevelControlButton_Click" />
                <TextBlock
                    Text="探针结果为实验记录，不代表正式兼容"
                    Opacity="0.7" />
                <TextBlock
                    x:Name="ProbeStatusText"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
            </Expander>

            <Border
                x:Name="ComponentCard"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="ComponentText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="二期 Host 显示基线"
                            Opacity="0.7" />
                        <TextBlock
                            x:Name="IdentityText"
                            Opacity="0.7"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Border
                            x:Name="StatusMarker"
                            Width="10"
                            Height="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="5" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                IsTextSelectionEnabled="True"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
